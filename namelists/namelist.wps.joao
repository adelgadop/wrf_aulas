&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2024-04-25_00:00:00', '2024-04-25_00:00:00', '2024-04-25_00:00:00',
 end_date   = '2024-04-30_00:00:00', '2024-04-30_00:00:00', '2024-04-30_00:00:00',
!opt_output_from_geogrid_path =  '/scr1/alejandro/proj/wrf_aulas/data/geo_em/',
 interval_seconds = 10800
/

&geogrid
 parent_id         =   1,    1,   2,
 parent_grid_ratio =   1,    4,   4,
 i_parent_start    =   1,   25, 168,
 j_parent_start    =   1,   20,  42,
 e_we              =  150, 261, 191,
 e_sn              =  100, 181, 161,
 geog_data_res = 'default', 'default', 'default',
 dx = 16000,
 dy = 16000,
 map_proj = 'lambert', 
 ref_lat   = -21.55,
 ref_lon   = -46.00,
 truelat1  = -30.00,
 truelat2  = -60.00,
 stand_lon = -45.00,
 geog_data_path = '/scr1/alejandro/shared/geo_hr/'
/

&ungrib
 out_format = 'WPS',
 prefix = 'SFC', 
/

&metgrid
 fg_name = 'SFC', 'PRL'
 io_form_metgrid = 2,
 opt_output_from_metgrid_path = '/scr1/alejandro/proj/wrf_aulas/data/met_em/',
 opt_metgrid_tbl_path         = './metgrid/',
/
