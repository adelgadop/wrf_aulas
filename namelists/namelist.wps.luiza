&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2024-04-25_00:00:00', '2024-04-25_00:00:00', 
 end_date   = '2024-04-29_00:00:00', '2024-04-29_00:00:00', 
 opt_output_from_geogrid_path =  './'
 interval_seconds = 10800
/

&geogrid
 parent_id         =   1,     1,
 parent_grid_ratio =   1,     5,
 i_parent_start    =   1,    35,
 j_parent_start    =   1,    26,
 e_we              = 101,   101,
 e_sn              =  75,   101,
 geog_data_res = 'default', 'default', 
 dx = 5000,
 dy = 5000,
 map_proj = 'mercator', 
 ref_lat   = -23.50,
 ref_lon   = -46.30,
 truelat1  = -30.00,
 truelat2  = -60.00,
 stand_lon = -45.00,
 geog_data_path = '/scr1/alejandro/shared/geo_hr/'
/

&ungrib
 out_format = 'WPS',
 prefix = 'SFC', 
/

&metgrid
 fg_name = 'SFC', 'PRL'
 io_form_metgrid = 2,
 opt_output_from_metgrid_path = '/scr1/alejandro/proj/wrf_aulas/data/met_em/',
 opt_metgrid_tbl_path         = './metgrid/',
/
